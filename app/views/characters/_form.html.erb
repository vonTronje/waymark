<%= form_with(model: character) do |form| %>
  <% if character.errors.any? %>
    <div class="alert alert-danger">
      <h2 class="h5"><%= pluralize(character.errors.count, "error") %> prohibited this character from being saved:</h2>

      <ul class="mb-0">
        <% character.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :level, class: "form-label" %>
    <%= form.number_field :level, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :character_class, class: "form-label" %>
    <%= form.text_field :character_class, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :species, class: "form-label" %>
    <%= form.text_field :species, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :image, class: "form-label" %>
    <%= form.file_field :image, class: "form-control" %>
  </div>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
