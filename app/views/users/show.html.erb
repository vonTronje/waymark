<%= render @user %>

<div class="d-flex flex-wrap gap-2 mt-3">
  <%= link_to "Edit this user", edit_user_path(@user), class: "btn btn-outline-primary" if policy(@user).edit? %>

  <%= button_to "Destroy this user", @user, method: :delete, class: "btn btn-outline-danger" if policy(@user).destroy? %>
</div>
